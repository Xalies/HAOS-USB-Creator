<Window x:Class="HAOSInstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:HAOSInstaller.App.Resources"
        mc:Ignorable="d"
        Title="{x:Static res:UiText.AppTitle}"
        Width="860"
        Height="625"
        MinWidth="820"
        MinHeight="560"
        Icon="/Assets/InstallerIcon.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HASurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource HADarkBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,28">
                    <Image Source="/Assets/InstallerIcon.png"
                           Width="68"
                           Height="68"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                    <TextBlock Text="{x:Static res:UiText.BrandLine1}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="{x:Static res:UiText.BrandLine2}"
                               Foreground="#7090B0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Border Height="1"
                            Background="#29445F"
                            Margin="0,22,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="24,0,24,0">
                    <TextBlock x:Name="StepWelcomeText" Margin="8,0,0,14" />
                    <TextBlock x:Name="StepDriveText" Margin="8,0,0,14" />
                    <TextBlock x:Name="StepConfirmText" Margin="8,0,0,14" />
                    <TextBlock x:Name="StepWriteText" Margin="8,0,0,14" />
                </StackPanel>

                <StackPanel x:Name="BuyMeCoffeePanel"
                            DockPanel.Dock="Bottom"
                            Margin="18,0,18,22"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:UiText.BuyMeCoffeeShortText}"
                               Foreground="#8FA9C4"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               Margin="0,0,0,7" />
                    <Border Width="128"
                            Height="36"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="{x:Static res:UiText.BuyMeCoffeeTooltip}"
                            MouseLeftButtonUp="BuyMeCoffeeImage_MouseLeftButtonUp">
                        <Image Source="/Assets/bmc-button.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="48,40,48,32">
            <Grid x:Name="WelcomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeadingStyle}" FontSize="26" Text="{x:Static res:UiText.WelcomeHeading}" />
                    <TextBlock Style="{StaticResource SubheadingStyle}"
                               Margin="0,8,0,28"
                               Text="{x:Static res:UiText.WelcomeSubheading}" />

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Height="303">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Margin="0,0,0,12" Text="{x:Static res:UiText.WelcomeWhatWillHappen}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8" Text="{x:Static res:UiText.WelcomeBulletEraseUsb}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8" Text="{x:Static res:UiText.WelcomeBulletDownloadHaos}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8" Text="{x:Static res:UiText.WelcomeBulletBootTarget}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8" Text="{x:Static res:UiText.WelcomeBulletOnlineCheck}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8" Text="{x:Static res:UiText.WelcomeBulletInstallTarget}" />
                            <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Static res:UiText.WelcomeBulletReboot}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:UiText.ButtonGetStarted}" Click="GetStarted_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DrivePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Style="{StaticResource HeadingStyle}" Text="{x:Static res:UiText.DriveHeading}" />
                    <TextBlock Style="{StaticResource SubheadingStyle}"
                               Text="{x:Static res:UiText.DriveSubheading}" />
                </StackPanel>

                <DockPanel Grid.Row="1">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    x:Name="DriveScanStatusPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressBar Width="86"
                                         Height="6"
                                         IsIndeterminate="True"
                                         Margin="0,0,10,0" />
                            <TextBlock x:Name="DriveScanStatusText"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Center"
                                       Text="{x:Static res:UiText.DriveScanning}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="RefreshDrivesButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{x:Static res:UiText.ButtonRefresh}"
                                Click="RefreshButton_Click" />
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="DriveEmptyText"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:UiText.DriveEmpty}"
                                   Visibility="Collapsed" />
                        <ListBox x:Name="DriveList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DriveListBoxItemStyle}"
                                 SelectionChanged="DriveList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DriveCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="6"
                                                    Background="{StaticResource HASurfaceBrush}"
                                                    Margin="0,0,14,0">
                                                <TextBlock Text="&#x1F4BE;"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BodyStyle}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Model}" />

                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource DrivePillWarningStyle}">
                                                                <Setter Property="Margin" Value="10,0,0,0" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLargeDrive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Style="{StaticResource DrivePillTextStyle}"
                                                                   Foreground="#B45309"
                                                                   Text="{x:Static res:UiText.DriveLarge}" />
                                                    </Border>

                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource DrivePillUsbStyle}">
                                                                <Setter Property="Margin" Value="6,0,0,0" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHaosInstaller}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Style="{StaticResource DrivePillTextStyle}"
                                                                   Foreground="#0B79A5"
                                                                   Text="{x:Static res:UiText.DriveHaosInstaller}" />
                                                    </Border>

                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource DrivePillDangerStyle}">
                                                                <Setter Property="Margin" Value="6,0,0,0" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowWindowsLayoutWarning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Style="{StaticResource DrivePillTextStyle}"
                                                                   Foreground="#B91C1C"
                                                                   Text="{x:Static res:UiText.DriveWindowsLayout}" />
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                                                    <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                                    <Run Text="{x:Static res:UiText.DriveDetailSeparator}" />
                                                    <Run Text="{Binding DevicePath, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="&#x203A;"
                                                       FontSize="20"
                                                       Foreground="{StaticResource HATextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiText.ButtonBack}" Margin="0,0,12,0" Click="BackToWelcome_Click" />
                    <Button x:Name="DriveNextButton" Style="{StaticResource PrimaryButton}" Content="{x:Static res:UiText.ButtonContinue}" IsEnabled="False" Click="DriveNext_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ConfirmPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Style="{StaticResource HeadingStyle}" Text="{x:Static res:UiText.ConfirmHeading}" />
                    <TextBlock Style="{StaticResource SubheadingStyle}"
                               Text="{x:Static res:UiText.ConfirmSubheading}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.ConfirmTargetUsb}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConfirmDriveModelText" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.ConfirmSize}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ConfirmDriveSizeText" Style="{StaticResource BodyStyle}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.ConfirmDevicePath}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConfirmDrivePathText" Style="{StaticResource BodyStyle}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.ConfirmStatus}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ConfirmDriveStatusText" Style="{StaticResource BodyStyle}" />
                        </Grid>
                    </Border>

                    <Border Background="#FFF8F0"
                            BorderBrush="{StaticResource HAWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,4,0,0">
                        <CheckBox x:Name="ConfirmEraseCheckBox"
                                  Checked="ConfirmEraseCheckBox_Changed"
                                  Unchecked="ConfirmEraseCheckBox_Changed">
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="{x:Static res:UiText.ConfirmEraseText}" />
                        </CheckBox>
                    </Border>

                    <Border Background="#FEF2F2"
                            BorderBrush="{StaticResource HADangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <CheckBox x:Name="UnattendedInstallCheckBox"
                                      Checked="UnattendedInstallCheckBox_Changed"
                                      Unchecked="UnattendedInstallCheckBox_Changed">
                                <TextBlock Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           Text="{x:Static res:UiText.UnattendedTitle}" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="26,8,0,0"
                                       Foreground="{StaticResource HADangerBrush}"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:UiText.UnattendedWarning}" />
                            <CheckBox x:Name="UnattendedWarningCheckBox"
                                      Margin="26,12,0,0"
                                      IsEnabled="False"
                                      Checked="UnattendedInstallCheckBox_Changed"
                                      Unchecked="UnattendedInstallCheckBox_Changed">
                                <TextBlock Style="{StaticResource BodyStyle}"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:UiText.UnattendedConfirmText}" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="{StaticResource HABorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox x:Name="SshAccessCheckBox"
                                      Checked="SshAccessCheckBox_Changed"
                                      Unchecked="SshAccessCheckBox_Changed">
                                <TextBlock Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           Text="{x:Static res:UiText.SshAccessTitle}" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="26,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:UiText.SshAccessWarning}" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="26,10,0,4"
                                       Text="{x:Static res:UiText.SshPasswordLabel}" />
                            <PasswordBox x:Name="SshPasswordBox"
                                         Margin="26,0,0,0"
                                         Height="30"
                                         IsEnabled="False"
                                         PasswordChanged="SshPasswordBox_PasswordChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:UiText.ButtonBack}" Margin="0,0,12,0" Click="BackToDrive_Click" />
                    <Button x:Name="ConfirmWriteButton"
                            Style="{StaticResource DangerButton}"
                            Content="{x:Static res:UiText.ButtonStartWrite}"
                            IsEnabled="False"
                            Click="ConfirmWriteButton_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WritePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource HeadingStyle}" Text="{x:Static res:UiText.WriteHeading}" />
                    <TextBlock Style="{StaticResource SubheadingStyle}" Text="{x:Static res:UiText.WriteSubheading}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="PrepareCard"
                                Background="White"
                                BorderBrush="{StaticResource HABorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               Text="{x:Static res:UiText.WritePrepareTitle}" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="PrepareBadge"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                                </Grid>
                                <TextBlock x:Name="PrepareStatusText"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Static res:UiText.WritePrepareInitial}" />
                                <ProgressBar x:Name="PrepareProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BootWriteCard"
                                Background="White"
                                BorderBrush="{StaticResource HABorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                Margin="0,0,0,10"
                                Opacity="0.5">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               Text="{x:Static res:UiText.WriteBootTitle}" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="BootWriteBadge"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                                </Grid>
                                <ProgressBar x:Name="BootWriteProgressBar" Minimum="0" Maximum="100" Margin="0,0,0,6" />
                                <TextBlock x:Name="BootWriteStatusText" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="HaosDownloadCard"
                                Background="White"
                                BorderBrush="{StaticResource HABorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                Margin="0,0,0,10"
                                Opacity="0.5">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               Text="{x:Static res:UiText.WriteDownloadTitle}" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="HaosDownloadBadge"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                                </Grid>
                                <ProgressBar x:Name="HaosDownloadProgressBar" Minimum="0" Maximum="100" Margin="0,0,0,6" />
                                <TextBlock x:Name="HaosDownloadStatusText"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Static res:UiText.WriteDownloadInitial}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CopyPayloadCard"
                                Background="White"
                                BorderBrush="{StaticResource HABorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,16"
                                Margin="0,0,0,10"
                                Opacity="0.5">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               Text="{x:Static res:UiText.WriteCopyTitle}" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="CopyPayloadBadge"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                                </Grid>
                                <ProgressBar x:Name="CopyPayloadProgressBar" Minimum="0" Maximum="100" Margin="0,0,0,6" />
                                <TextBlock x:Name="CopyPayloadStatusText" Style="{StaticResource CaptionStyle}" Text="{x:Static res:UiText.WriteBadgeWaiting}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="WriteErrorCard"
                                Background="#FEF2F2"
                                BorderBrush="{StaticResource HADangerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static res:UiText.WriteErrorIcon}"
                                           Foreground="{StaticResource HADangerBrush}"
                                           FontSize="16"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Name="WriteErrorText"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{StaticResource HADangerBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Margin="0,16,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="{x:Static res:UiText.ButtonBack}"
                            Click="BackToConfirm_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="FinishPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeadingStyle}" Text="{x:Static res:UiText.FinishHeading}" />
                    <TextBlock x:Name="FinishSummaryText"
                               Style="{StaticResource SubheadingStyle}"
                               Margin="0,8,0,20"
                               Text="{x:Static res:UiText.FinishSummaryDefault}" />
                    <Border Style="{StaticResource CardStyle}">
                        <TextBlock x:Name="FinishNextStepText"
                                   Style="{StaticResource BodyStyle}"
                                   Text="{x:Static res:UiText.FinishNextStepAttended}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:UiText.ButtonStartOver}" Click="StartOver_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>




