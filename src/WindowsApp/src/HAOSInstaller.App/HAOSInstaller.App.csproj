<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HAOSInstaller.Core\HAOSInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BootImage\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\bmc-button.png" />
    <Resource Include="Assets\InstallerIcon.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>HAOSAIOUsbCreator</AssemblyName>
    <Product>HAOS AIO USB Creator</Product>
    <Authors>Sonny Gilbert</Authors>
    <Company>Sonny Gilbert</Company>
    <Copyright>Copyright (c) 2026 Sonny Gilbert</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

</Project>
