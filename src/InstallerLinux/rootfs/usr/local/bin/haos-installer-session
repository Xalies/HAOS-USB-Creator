#!/bin/sh
set +e

export TERM="${TERM:-linux}"

if command -v tmux >/dev/null 2>&1; then
  tmux has-session -t haos-installer 2>/dev/null || {
    tmux new-session -d -s haos-installer /usr/local/bin/haos-installer-run
    tmux set-option -t haos-installer status off >/dev/null 2>&1 || true
    tmux set-window-option -t haos-installer:0 window-size latest >/dev/null 2>&1 || true
  }
  exec tmux attach-session -t haos-installer
fi

exec /usr/local/bin/haos-installer-run
