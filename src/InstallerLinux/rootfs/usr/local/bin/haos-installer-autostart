#!/bin/sh
set +e

export TERM="${TERM:-linux}"

clear 2>/dev/null || true
printf '%s\n' 'HAOS AIO Installer USB'
printf '%s\n' 'Console: /dev/tty1'
printf '%s\n' 'Debug shell: Alt+F2'
printf '\n'

use_ssh_session=0
cache_device="$(blkid -L HAOS-CACHE 2>/dev/null || true)"
if [ -n "$cache_device" ]; then
  mkdir -p /mnt/haos-cache 2>/dev/null || true
  mountpoint -q /mnt/haos-cache 2>/dev/null || mount -o rw "$cache_device" /mnt/haos-cache 2>/dev/null || true
  config="/mnt/haos-cache/cache/installer-config.json"
  if [ -f "$config" ] && command -v jq >/dev/null 2>&1; then
    jq -e '.ssh.enabled == true and (.ssh.password // "" | length > 0)' "$config" >/dev/null 2>&1 && use_ssh_session=1
  fi
fi

if [ "$use_ssh_session" = "1" ]; then
  /usr/local/bin/haos-installer-session
else
  /usr/local/bin/haos-installer-run
fi
status=$?

printf '\n'
printf 'The installer stopped before it could continue. Exit code: %s\n' "$status"
printf 'Press Enter to open a shell, or press Ctrl+Alt+Del to reboot.\n'
read -r _unused 2>/dev/null || true

exec /bin/sh -l
