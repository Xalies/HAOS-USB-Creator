src/WindowsApp/src/HAOSInstaller.App/Assets/BootImage/*.usb
src/WindowsApp/src/HAOSInstaller.App/Assets/BootImage/*.sha256
src/WindowsApp/src/HAOSInstaller.App/Assets/BootImage/*.manifest.json

